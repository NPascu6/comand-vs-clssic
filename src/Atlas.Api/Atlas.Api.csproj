<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atlas.Functional.Commands\Atlas.Functional.Commands.csproj" />
    <ProjectReference Include="..\Atlas.Upstream.Contracts\Atlas.Upstream.Contracts.csproj" />
  </ItemGroup>

  <!-- OpenAPI document generation. Microsoft's own package (part of ASP.NET Core),
       not Swashbuckle: it reads the endpoints the framework already knows about and
       the JSON options configured in Program, so there is nothing to keep in sync. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.0.1" />
    <!-- Pinned: the 2.0.0 that Microsoft.AspNetCore.OpenApi drags in transitively has
         a known high-severity advisory (GHSA-v5pm-xwqc-g5wc). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <!-- Ship the translation files next to the binary so they're readable at
       runtime (published output). PreserveNewest re-copies edited files.
       The Web SDK already globs *.json as Content, so we Update (not Include)
       to set CopyToOutputDirectory without creating duplicate items. -->
  <ItemGroup>
    <Content Update="i18n\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
