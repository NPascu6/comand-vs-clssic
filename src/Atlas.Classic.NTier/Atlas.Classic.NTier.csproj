<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Atlas.Upstream.Contracts\Atlas.Upstream.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Atlas.Classic.NTier</RootNamespace>
  </PropertyGroup>

  <!-- AppetiteConfigFactory reads this file from the output directory, so it must ship beside the binary. -->
  <ItemGroup>
    <Content Include="Configuration\appetite.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
