{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src",
    "module": "ESNext",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true
  }
}
