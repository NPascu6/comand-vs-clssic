{
  "name": "@atlas/figma-sync",
  "version": "0.1.0",
  "type": "module",
  "description": "Turns a Figma variables export into the committed design-token files, a versioned ledger that records who changed what, and the pull request body that reviews it. Pure TypeScript, no dependencies.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "sync": "node scripts/figma-sync.ts",
    "check": "node scripts/figma-sync.ts --check",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@atlas/commands": "workspace:*",
    "@atlas/contracts": "workspace:*",
    "@atlas/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
