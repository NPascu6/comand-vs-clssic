{
  "name": "@atlas/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Atlas shared component library (design system). Owns the design tokens + Tailwind preset; exposes a stable component API. Being decoupled from MUI (./legacy) toward an owned Tailwind implementation (default export).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./legacy": "./src/legacy/index.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./tailwind-preset": "./tailwind-preset.cjs"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/material": "^6.1.9"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  }
}
