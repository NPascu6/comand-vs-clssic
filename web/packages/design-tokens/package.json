{
  "name": "@atlas/design-tokens",
  "version": "0.1.0",
  "type": "module",
  "description": "Figma variables (W3C Design Tokens JSON) transformed into the typed theme inputs createAtlasTheme reads. Pure TypeScript, no dependencies; the generated output is committed and checked in CI.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "figma"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node scripts/build-tokens.ts && tsc -p tsconfig.build.json",
    "check": "node scripts/build-tokens.ts --check",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
