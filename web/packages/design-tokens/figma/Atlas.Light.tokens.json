{
  "palette": {
    "mode": {
      "$type": "string",
      "$value": "light",
      "$description": "MUI palette mode"
    }
  },
  "color": {
    "$type": "color",
    "primary": {
      "main": {
        "$value": "#0F2143"
      },
      "light": {
        "$value": "#1B3460"
      },
      "soft": {
        "$value": "#E7EEFB",
        "$description": "The tint a soft control sits on"
      },
      "contrastText": {
        "$value": "#FFFFFF"
      }
    },
    "secondary": {
      "main": {
        "$value": "#1B3460"
      }
    },
    "success": {
      "main": {
        "$value": "#1C9D71"
      }
    },
    "warning": {
      "main": {
        "$value": "#BA801D"
      }
    },
    "error": {
      "main": {
        "$value": "#D9534F"
      }
    },
    "info": {
      "main": {
        "$value": "{color.secondary.main}"
      }
    },
    "text": {
      "primary": {
        "$value": "#16223A"
      },
      "secondary": {
        "$value": "#627089"
      }
    },
    "divider": {
      "$value": "#E3E9F2"
    },
    "background": {
      "default": {
        "$value": "#F6F8FB"
      },
      "paper": {
        "$value": "#FFFFFF"
      }
    }
  },
  "border": {
    "width": {
      "$type": "number",
      "$value": 1
    },
    "color": {
      "$type": "color",
      "$value": "{color.divider}"
    }
  },
  "focus": {
    "width": {
      "$type": "number",
      "$value": 0,
      "$description": "0 = MUI's default focus ring"
    },
    "color": {
      "$type": "color",
      "$value": "{color.primary.main}"
    }
  },
  "series": {
    "$type": "color",
    "$description": "Categorical chart colours, in order, on a light surface",
    "1": {
      "$value": "#0F2143"
    },
    "2": {
      "$value": "#1FA97A"
    },
    "3": {
      "$value": "#E0A33B"
    },
    "4": {
      "$value": "#7A5BB0"
    },
    "5": {
      "$value": "#2E86AB"
    },
    "6": {
      "$value": "#C1554E"
    },
    "7": {
      "$value": "#4F7942"
    },
    "8": {
      "$value": "#8A7E6D"
    }
  }
}
