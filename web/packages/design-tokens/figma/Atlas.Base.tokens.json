{
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica", "Arial", "sans-serif"] },
    "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Consolas", "Menlo", "monospace"] }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "8px", "$description": "Buttons, inputs, MUI shape.borderRadius" },
    "surface": { "$value": "12px", "$description": "Cards, papers, the data grid" }
  },
  "typography": {
    "button": {
      "weight": { "$type": "fontWeight", "$value": 600 }
    },
    "chip": {
      "weight": { "$type": "fontWeight", "$value": 600 }
    },
    "overline": {
      "size": { "$type": "dimension", "$value": "11px" },
      "weight": { "$type": "fontWeight", "$value": 600 },
      "letterSpacing": { "$type": "string", "$value": "0.08em" },
      "lineHeight": { "$type": "number", "$value": 1.6 }
    },
    "tableHeader": {
      "size": { "$type": "dimension", "$value": "11px" },
      "weight": { "$type": "fontWeight", "$value": 700 },
      "letterSpacing": { "$type": "string", "$value": "0.06em" }
    }
  }
}
