{
  "name": "atlas-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Atlas web monorepo — the Figma token export, the `core` design system built on it, and a proof of concept showing an application built with no CSS of its own.",
  "scripts": {
    "dev": "pnpm --filter @atlas/designer-poc dev",
    "build": "pnpm --filter @atlas/designer-poc build",
    "build:packages": "pnpm -r --filter './packages/**' run build",
    "build:storybook": "pnpm --filter @atlas/core build-storybook",
    "clean": "pnpm -r run clean",
    "preview": "pnpm --filter @atlas/designer-poc preview",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r exec tsc --noEmit && tsc -p build"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
